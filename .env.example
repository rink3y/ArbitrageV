# Required: JSON-RPC and the signer used for execution.
RPC_URL=https://your-chain-rpc.example
PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# Recommended: lower-latency event subscriptions. The bot falls back to HTTP RPC.
WSS_URL=wss://your-chain-rpc.example

# Deployed contracts used for execution and market sync.
ARB_CONTRACT_ADDRESS=0xYOUR_ARBITRAGE_CONTRACT
UNISWAP_FLASH_QUERY_CONTRACT_ADDRESS=0xYOUR_FLASH_QUERY_CONTRACT

# Optional runtime settings.
# Leave blank for data/markets-<NETWORK.chain.id>.sqlite.
MARKET_DB_PATH=
DEBUG=false

# Optional transaction notifications. Leave both blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
